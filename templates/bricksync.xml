<Container>

<Name>BrickSync</Name>

<Repository>brandonb1987/unraid-bricksync:latest</Repository>

<Icon>https://raw.githubusercontent.com/brandonb1987/BrickSync_Unraid_Docker/main/icon.jpg</Icon>

<Network>bridge</Network>

<Shell>Shell</Shell>

<Privileged>false</Privileged>

<Overview>
BrickSync synchronizes inventory between BrickLink and BrickOwl.
</Overview>

<Project>https://github.com/ZZJHONS/Bricksync</Project>

<TemplateURL>https://raw.githubusercontent.com/brandonb1987/BrickSync_Unraid_Docker/main/templates/bricksync.xml</TemplateURL>

<Category>Tools:System</Category>

<ExtraSearchTerms>BrickSync BrickLink BrickOwl inventory synchronization</ExtraSearchTerms>

<License>MIT</License>

<!-- Persistent application data -->

<Config
  Name="Appdata"
  Target="/opt/bricksync/data"
  Default="/mnt/user/appdata/bricksync"
  Mode="rw"
  Description="Persistent BrickSync configuration and data"
  Type="Path"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<!-- BrickLink credentials -->

<Config
  Name="BrickLink Consumer Key"
  Target="BRICKLINK_CONSUMERKEY"
  Default=""
  Mode="1"
  Description="BrickLink consumer key"
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<Config
  Name="BrickLink Consumer Secret"
  Target="BRICKLINK_CONSUMERSECRET"
  Default=""
  Mode="1"
  Description="BrickLink consumer secret"
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<Config
  Name="BrickLink API Token"
  Target="BRICKLINK_TOKEN"
  Default=""
  Mode="1"
  Description="BrickLink API token"
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<Config
  Name="BrickLink API Token Secret"
  Target="BRICKLINK_TOKENSECRET"
  Default=""
  Mode="1"
  Description="BrickLink API token secret"
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<!-- BrickOwl credentials -->

<Config
  Name="BrickOwl API Key"
  Target="BRICKOWL_KEY"
  Default=""
  Mode="1"
  Description="BrickOwl API key"
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<!-- Optional automatic confirmation -->

<Config
  Name="Auto-confirm empty inventory"
  Target="BRICKSYNC_AUTO_CONFIRM_EMPTY"
  Default="false"
  Mode="1"
  Description="Set to true only when you intentionally want to approve BrickSync's empty-inventory synchronization prompt automatically. Requires the Docker image to implement the automatic-confirmation wrapper."
  Type="Variable"
  Display="always"
  Required="true"
  Mask="false">
</Config>

</Container>
