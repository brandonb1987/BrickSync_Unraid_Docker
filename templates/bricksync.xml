<Container>

<Name>BrickSync</Name>

<Repository>brandonb1987/unraid-bricksync:latest</Repository>

<Icon>https://raw.githubusercontent.com/brandonb1987/BrickSync_Unraid_Docker/main/icon.svg</Icon>
  
<Network>bridge</Network>

<Shell>bash</Shell>

<Privileged>false</Privileged>
  
<Overview>
BrickSync synchronizes inventory between BrickLink and BrickOwl.</Overview>

<Project>https://github.com/ZZJHONS/Bricksync</Project>

<TemplateURL>https://raw.githubusercontent.com/brandonb1987/BrickSync_Unraid_Docker/main/templates/bricksync.xml</TemplateURL>

<Category>Tools:System</Category>

<ExtraSearchTerms>BrickSync BrickLink BrickOwl inventory synchronization</ExtraSearchTerms>

<License>MIT</License>

<!-- Persistent application data -->

<Config
  Name="Appdata"
  Target="/opt/bricksync/data"
  Default="/mnt/user/appdata/bricksync"
  Mode="rw"
  Description=""
  Type="Path"
  Display="always"
  Required="true"
  Mask="false">
</Config>

<!-- BrickLink credentials -->

<Config
  Name="BrickLink Consumer Key"
  Target="BRICKLINK_CONSUMERKEY"
  Default=""
  Mode="1"
  Description=""
  Type="Variable"
  Display="always"
  Required="true"
  Mask="true">
</Config>

<Config
  Name="BrickLink Consumer Secret"
  Target="BRICKLINK_CONSUMERSECRET"
  Default=""
  Mode="1"
  Description=""
  Type="Variable"
  Display="always"
  Required="true"
  Mask="true">
</Config>

<Config
  Name="BrickLink API Token"
  Target="BRICKLINK_TOKEN"
  Default=""
  Mode="1"
  Description=""
  Type="Variable"
  Display="always"
  Required="true"
  Mask="true">
</Config>

<Config
  Name="BrickLink API Token Secret"
  Target="BRICKLINK_TOKENSECRET"
  Default=""
  Mode="1"
  Description=""
  Type="Variable"
  Display="always"
  Required="true"
  Mask="true">
</Config>

<!-- BrickOwl credentials -->

<Config
  Name="BrickOwl API Key"
  Target="BRICKOWL_KEY"
  Default=""
  Mode="1"
  Description=""
  Type="Variable"
  Display="always"
  Required="true"
  Mask="true">
</Config>

</Container>
